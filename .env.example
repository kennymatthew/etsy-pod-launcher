# Copy this file to .env and fill in your own values.
# Never commit .env — it contains your private API keys.

# ── Printify ──────────────────────────────────────────────────────────────────
# Get your token: https://printify.com/app/account/api
# Click "Generate token", give it all scopes (shops, products, orders, uploads).
PRINTIFY_API_TOKEN=your_printify_api_token_here

# Your shop ID — find it in the URL after logging in to Printify:
#   https://printify.com/app/store/products → the number in the URL is your shop ID
# Or call: curl -H "Authorization: Bearer YOUR_TOKEN" https://api.printify.com/v1/shops.json
PRINTIFY_SHOP_ID=your_printify_shop_id_here

# ── Etsy ──────────────────────────────────────────────────────────────────────
# Get your keystring: https://www.etsy.com/developers/your-apps → create an app → copy the keystring
# Free tier — no payment needed. Used to fetch listing creation dates (1 call per scraped listing).
ETSY_API_KEY=your_etsy_keystring_here

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Used by generate-design-patterns.py (Phase 1 only — pattern discovery per niche)
# Get your key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Firecrawl ─────────────────────────────────────────────────────────────────
# Get your key: https://www.firecrawl.dev/app/api-keys
# Free tier gives 500 credits/month — enough for ~100 listing scrapes.
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3333
